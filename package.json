{
  "name": "gatekeeper-headlamp-plugin",
  "version": "0.1.1",
  "description": "Headlamp plugin for OPA Gatekeeper policies and violations",
  "main": "dist/main.js",
  "scripts": {
    "build": "headlamp-plugin build",
    "package": "headlamp-plugin package",
    "start": "headlamp-plugin start",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "format": "headlamp-plugin format",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "tsc": "headlamp-plugin tsc",
    "extract": "headlamp-plugin extract . .plugins"
  },
  "keywords": [
    "headlamp",
    "plugin",
    "kubernetes",
    "gatekeeper",
    "opa",
    "policy"
  ],
  "author": "Sertac Ozercan",
  "license": "Apache-2.0",
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.12.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.0",
    "js-yaml": "^4.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}